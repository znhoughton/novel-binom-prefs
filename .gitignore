# R
.Rproj.user/
.Rhistory
.RData

# Python
__pycache__/
*.pyc

# brms fits: regenerable from the Rmds, and large
Analysis/models/*.rds

# The experiment is its own repo, synced to Pavlovia:
# https://gitlab.pavlovia.org/znhoughton/novel-binom-judgements
# Its conditions file is mirrored to Data/ so this repo stands alone.
Experiment/

# Scratch
*.tmp

# Run logs. score_llm_prefs.py writes one per nohup invocation on the server,
# and they are mostly tqdm redraw noise. The CSVs are the durable record.
*.log

# infini-gram query caches. Intermediate state that churns while a check runs;
# the derived CSVs (bigram_logodds_*.csv, novelty_*.csv) are the durable record.
Data/.bigram_count_cache.json
Data/.novelty_cache_*.json

# Quarto render artefacts
Writeup/*.pdf
Writeup/*.tex
Writeup/*.html
Writeup/*_files/
Writeup/.quarto/
